<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="per:Page">
    <jcr:content
        jcr:primaryType="per:PageContent"
        jcr:title="standard template"
        sling:resourceType="pagerenderervanilla/structure/page">

      <!-- the frame every page inherits: header, an empty container for the
           page's own content, footer. Without the container an author has
           nowhere to drop anything. -->
      <header jcr:primaryType="nt:unstructured"
          sling:resourceType="peregrinevanilla/components/header"
          brand="PEREGRINE"
          brandlink="/content/peregrinevanilla/pages/index"
          logo="/content/peregrinevanilla/assets/mark.svg"
          logoalt="Poster"
          boxtext="GITHUB"
          boxlink="https://github.com/headwirecom/peregrine-cms">
        <navitems jcr:primaryType="nt:unstructured">
          <i0 jcr:primaryType="nt:unstructured" text="START" link="/content/peregrinevanilla/pages/index"/>
          <i1 jcr:primaryType="nt:unstructured" text="AUTHORING" link="/content/peregrinevanilla/pages/index"/>
          <i2 jcr:primaryType="nt:unstructured" text="REFERENCE" link="/content/peregrinevanilla/pages/index"/>
        </navitems>
      </header>

      <main jcr:primaryType="nt:unstructured"
          sling:resourceType="pagerenderervanilla/structure/container"/>

      <footer jcr:primaryType="nt:unstructured"
          sling:resourceType="peregrinevanilla/components/footer"
          brand="PEREGRINE"
          logo="/content/peregrinevanilla/assets/mark.svg"
          lefttext="OPEN SOURCE — APACHE-2.0"
          righttext="BUILT WITH PEREGRINE CMS"/>

    </jcr:content>
</jcr:root>
