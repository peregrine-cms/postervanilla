<?xml version="1.0" encoding="UTF-8"?>
<!-- The theme's reference page: every component used once, in the layout the
     theme was designed around. It doubles as the acceptance test - if this
     page looks wrong, the theme is wrong. -->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="per:Page">
    <jcr:content
        jcr:primaryType="per:PageContent"
        jcr:title="Poster"
        jcr:description="Reference page for the Poster theme"
        sling:resourceType="pagerenderervanilla/structure/page"
        template="/content/peregrinevanilla/templates/standard">

      <main jcr:primaryType="nt:unstructured"
          sling:resourceType="pagerenderervanilla/structure/container">

        <hero jcr:primaryType="nt:unstructured"
            sling:resourceType="peregrinevanilla/components/hero"
            title="What you edit is what you ship"
            footnote="literally. The editor renders your real site - the page you drag components onto is the page a visitor gets."
            ctatext="Read the docs"
            ctalink="/content/peregrinevanilla/pages/index"
            cta2text="GitHub"
            cta2link="https://github.com/headwirecom/peregrine-cms"
            image="/content/peregrinevanilla/assets/mark.svg"
            imagealt=""/>

        <ticker jcr:primaryType="nt:unstructured"
            sling:resourceType="peregrinevanilla/components/ticker"
            text="OPEN SOURCE · APACHE-2.0 · BUILT ON APACHE SLING · CONTENT IS A REPOSITORY · DOCS FROM PASSING TESTS · **ONE CONTAINER TO TRY IT** · "
            speed="normal"/>

        <claims jcr:primaryType="nt:unstructured"
            sling:resourceType="peregrinevanilla/components/claims">
          <items jcr:primaryType="nt:unstructured">
            <i0 jcr:primaryType="nt:unstructured" title="Docs that cannot lie" text="Every screenshot in the manual comes from a passing, asserted test run against a clean install."/>
            <i1 jcr:primaryType="nt:unstructured" title="Everything is content" text="Pages, assets, objects, even the console. One tree, versioned, readable as JSON from anywhere."/>
            <i2 jcr:primaryType="nt:unstructured" title="Themes are yours" text="A site starts as a copy of a theme. Fork nothing, wait for no build - change what you copied."/>
          </items>
        </claims>

        <manual jcr:primaryType="nt:unstructured"
            sling:resourceType="peregrinevanilla/components/band"
            background="orange" bordered="true" contained="true">
          <heading jcr:primaryType="nt:unstructured"
              sling:resourceType="peregrinevanilla/components/blkheading"
              text="The manual" size="band" level="h2"/>
          <index jcr:primaryType="nt:unstructured"
              sling:resourceType="peregrinevanilla/components/indexlist"
              startat="1">
            <items jcr:primaryType="nt:unstructured">
              <i0 jcr:primaryType="nt:unstructured" title="Your first website" tag="START HERE" link="/content/peregrinevanilla/pages/index"/>
              <i1 jcr:primaryType="nt:unstructured" title="Pages" tag="START HERE" link="/content/peregrinevanilla/pages/index"/>
              <i2 jcr:primaryType="nt:unstructured" title="The editor" tag="AUTHORING" link="/content/peregrinevanilla/pages/index"/>
              <i3 jcr:primaryType="nt:unstructured" title="Content · Assets · Objects · Templates" tag="AUTHORING" link="/content/peregrinevanilla/pages/index"/>
              <i4 jcr:primaryType="nt:unstructured" title="Publishing · Administration" tag="RUNNING" link="/content/peregrinevanilla/pages/index"/>
              <i5 jcr:primaryType="nt:unstructured" title="Tools · For developers" tag="REFERENCE" link="/content/peregrinevanilla/pages/index"/>
            </items>
          </index>
        </manual>

        <tryit jcr:primaryType="nt:unstructured"
            sling:resourceType="peregrinevanilla/components/band"
            background="ink" contained="true">
          <heading jcr:primaryType="nt:unstructured"
              sling:resourceType="peregrinevanilla/components/blkheading"
              text="Try it" size="band" level="h2"/>
          <cmd jcr:primaryType="nt:unstructured"
              sling:resourceType="peregrinevanilla/components/command"
              text="docker run -p 8080:8080 peregrinecms/peregrine-cms:v2-preview"
              prompt="$"
              comment="console at /content/adminv2 once it boots"/>
        </tryit>

        <nav jcr:primaryType="nt:unstructured"
            sling:resourceType="peregrinevanilla/components/pagenav"
            uptext="All chapters"
            uplink="/content/peregrinevanilla/pages/index"
            nexttext="Your first website"
            nextlink="/content/peregrinevanilla/pages/index"/>

      </main>
    </jcr:content>
</jcr:root>
